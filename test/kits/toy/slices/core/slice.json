{
  "params": {
    "gate": {"required": true, "pattern": "^[^\"'$`;&|\\n]+$", "init": "check_command"},
    "gate_landing": {"default": "{{kit.gate}}", "pattern": "^[^\"'$`;&|\\n]+$"},
    "memory_root": {"default": ".claude/memory", "pattern": "^[^\"'$`;&|\\n]+$", "init": "memory_import"}
  },
  "set": {"autoMemoryEnabled": false},
  "forbid": [
    {"entry": "Bash(gh *)", "reason": "broad gh can move origin/main without the push prompt"}
  ]
}
